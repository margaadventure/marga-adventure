---
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'fr' } }];
}

import { useAstroI18n } from "../../../i18n/astro";
import Layout from "../../../layouts/Layout.astro";
import TripItineraryPage from "../../../components/TripItineraryPage";

const { lang, baseUrl, t, tripData, dict, enDict } = await useAstroI18n(Astro.url);
const trip = tripData("photography.tshechu") || {};

const packingList = [
    {
        category: "Camera Gear",
        items: [
            "Full-frame DSLR/Mirrorless Body (plus a backup body)",
            "Wide-angle Lens (16-35mm) for landscapes and architecture",
            "Telephoto Lens (70-200mm or 100-400mm) for wildlife and portraits",
            "Fast Prime Lens (35mm or 50mm f/1.8) for low light & street",
            "Sturdy Tripod for landscapes and low-light shots",
            "ND & Polarizer Filters",
            "Extra Batteries & Memory Cards (cold drains batteries fast)",
        ],
    },
    {
        category: "Clothing & Essentials",
        items: [
            "Warm Layers (Down Jacket, Fleece) for mornings",
            "Comfortable Walking Shoes",
            "Lightweight Rain Jacket",
            "Dust Mask / Buff for dusty roads",
            "Headlamp for early morning starts",
        ],
    },
];

import bgImage from "../../../assets/images/activities/photography/tshechu-photography_5.webp";
import type { Locale } from "../../../i18n/i18n";
---
<Layout
    title={`${trip.title || 'Tshechu Festival & Sacred Cham Dances'} | Marga Adventure`}
    image={bgImage.src}
    keywords="Tshechu Festival photography, Cham masked dance Nepal, Shechen monastery, Tibetan Buddhist rituals, Nepal cultural photography"
>
    <TripItineraryPage
        title={trip.title || "Tshechu Festival & Sacred Cham Dances"}
        subtitle={trip.subtitle || "Monastic Rituals, Masked Cham Dances & Himalayan Culture"}
        heroImage={bgImage.src}
        overview={trip.overview || ""}
        highlights={trip.highlights || []}
        itinerary={trip.itinerary || []}
        tripStats={{
            duration: trip.duration || "12 Days",
            maxAltitude: trip.maxAltitude || "Monastic & Photo",
            maxAltitudeLabel: trip.maxAltitudeLabel || "Trip Type",
            difficulty: trip.difficulty || "Easy",
            groupSize: trip.groupSize || "2-10",
        }}
        showElevationGraph={false}
        packingList={packingList}
        client:load
        initialLocale={lang}
        initialDict={dict}
        initialFallbackDict={enDict}
    />
</Layout>
