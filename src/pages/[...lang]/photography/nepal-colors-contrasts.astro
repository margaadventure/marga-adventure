---
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'fr' } }];
}

import { useAstroI18n } from "../../../i18n/astro";
import Layout from "../../../layouts/Layout.astro";
import TripItineraryPage from "../../../components/TripItineraryPage";

const { lang, baseUrl, t, tripData, dict, enDict } = await useAstroI18n(Astro.url);
const trip = tripData("photography.nepalColorsContrastsTrip") || {};

const packingList = [
    {
        category: "Camera Gear",
        items: [
            "Full-frame DSLR/Mirrorless Body (plus a backup body)",
            "Wide-angle Lens (16-35mm) for landscapes, architecture and festival crowds",
            "Telephoto Lens (70-200mm or 100-400mm) for wildlife in Chitwan and portraits",
            "Fast Prime Lens (35mm or 50mm f/1.8) for low light & street",
            "Sturdy Tripod & remote shutter release",
            "Protective rain cover & dust covers for camera gear",
            "Extra Batteries & Memory Cards (plenty of spares)",
        ],
    },
    {
        category: "Clothing & Essentials",
        items: [
            "Comfortable, sturdy walking shoes",
            "Lightweight, breathable clothing for warm days in Chitwan",
            "Warm layers (Down jacket/fleece) for mornings in Pokhara/Durlung",
            "Dust Mask or Buff (very useful for dusty roads and crowds)",
            "Sun hat, sunglasses, and high-factor sunscreen",
            "Small daypack for carrying gear and personal items",
        ],
    },
];

import bgImage from "../../../assets/images/activities/photography/Photography 1_.webp";
import imgHeadstand from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_headstand_meditation.webp";
import imgMistyProcession from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_misty_procession.webp";
import imgTraditionalAttire from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_traditional_attire.webp";
import imgHorseCart from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_horse_cart_driver.webp";
import imgPlowingTerraces from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_pllowing_terraces.webp";

import imgRhinos from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_chitwan_rhinos.webp";
import imgNyatapola from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_nyatapola_temple.webp";
import imgBoudhanath from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_boudhanath_stupa.webp";
import imgSadhu from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_pashupatinath_sadhu.webp";
import imgMonks from "../../../assets/images/activities/photography/shivaratri-gallery/shivaratri_monks_machhapuchhre.webp";
import type { Locale } from "../../../i18n/i18n";

const shivaratriBlockImages = [
    {
        src: imgSadhu.src,
        caption: "Portrait of a Devout Sadhu at Pashupatinath",
        alt: "Revered Hindu Sadhu with floral crown and sacred ash face paint during Shivaratri festival at Pashupatinath",
        subtitle: "Sacred Festival & Spiritual Invocations",
        location: "overview",
        width: imgSadhu.width,
        height: imgSadhu.height
    },
    {
        src: imgBoudhanath.src,
        caption: "Devotional Reflections at Boudhanath Stupa",
        alt: "Boudhanath Stupa with colorful prayer flags and brass offering bowls in Kathmandu Valley",
        subtitle: "Kathmandu Valley Cultural Heritage",
        location: "highlights",
        width: imgBoudhanath.width,
        height: imgBoudhanath.height
    }
];

const shivaratriGalleryImages = [
    {
        src: imgSadhu.src,
        caption: "Portrait of a Devout Sadhu at Pashupatinath",
        alt: "Hindu Sadhu with floral crown at Pashupatinath",
        width: imgSadhu.width,
        height: imgSadhu.height
    },
    {
        src: imgBoudhanath.src,
        caption: "Devotional Reflections at Boudhanath Stupa",
        alt: "Boudhanath Stupa with prayer flags and offering bowls",
        width: imgBoudhanath.width,
        height: imgBoudhanath.height
    },
    {
        src: imgNyatapola.src,
        caption: "Nyatapola Pagoda Temple of Bhaktapur",
        alt: "Five-story Nyatapola Temple pagoda in Bhaktapur Durbar Square",
        width: imgNyatapola.width,
        height: imgNyatapola.height
    },
    {
        src: imgMonks.src,
        caption: "Monks Contemplating Machhapuchhre Peak",
        alt: "Young Buddhist monks in red robes before Fishtail mountain",
        width: imgMonks.width,
        height: imgMonks.height
    },
    {
        src: imgRhinos.src,
        caption: "Wild One-Horned Rhinos of Chitwan",
        alt: "Three One-Horned Rhinoceroses in Chitwan National Park",
        width: imgRhinos.width,
        height: imgRhinos.height
    },
    {
        src: imgHeadstand.src,
        caption: "Yogic Transformation Under Himalayan Peaks",
        alt: "Yogi practicing Shirshasana headstand pose in high mountain meadow",
        width: imgHeadstand.width,
        height: imgHeadstand.height
    },
    {
        src: imgTraditionalAttire.src,
        caption: "Elegance of Ancient Himalayan Dress",
        alt: "Himalayan woman in traditional blue and maroon chubba",
        width: imgTraditionalAttire.width,
        height: imgTraditionalAttire.height
    },
    {
        src: imgMistyProcession.src,
        caption: "Misty Morning Procession in Himalayan Foothills",
        alt: "Villagers walking through misty forest carrying harvest bundles",
        width: imgMistyProcession.width,
        height: imgMistyProcession.height
    },
    {
        src: imgHorseCart.src,
        caption: "Journey Across Dusty Mountain Trails",
        alt: "Horse cart driver on dirt road with orange cloth wrapped around face",
        width: imgHorseCart.width,
        height: imgHorseCart.height
    },
    {
        src: imgPlowingTerraces.src,
        caption: "Timeless Harvest Beneath Sacred Peaks",
        alt: "Farmers plowing terraced fields with oxen under Annapurna mountains",
        width: imgPlowingTerraces.width,
        height: imgPlowingTerraces.height
    }
];
---
<Layout
    title={`${trip.title || 'Shivaratri Festival: Color and Contrast to Nepal'} | Marga Adventure`}
    image={bgImage.src}
    keywords="Nepal photography, Shivaratri festival, Losar festival, Chitwan safari, Pokhara sunrise, Gurung culture, Annapurna views"
>
    <TripItineraryPage
        title={trip.title || "Shivaratri Festival: Color and Contrast to Nepal"}
        subtitle={trip.subtitle || "A Photographer's Paradise & Sacred Festivals"}
        heroImage={bgImage.src}
        overview={trip.overview || ""}
        highlights={trip.highlights || []}
        itinerary={trip.itinerary || []}
        tripStats={{
            duration: trip.duration || "15 Days",
            maxAltitude: trip.maxAltitude || "Festival & Photo",
            maxAltitudeLabel: trip.maxAltitudeLabel || "Trip Type",
            difficulty: trip.difficulty || "Easy",
            groupSize: trip.groupSize || "2-10",
        }}
        showElevationGraph={false}
        packingList={packingList}
        blockImages={shivaratriBlockImages}
        galleryImages={shivaratriGalleryImages}
        galleryTitle="Shivaratri Festival Photography Collection"
        gallerySubtitle="Color and Contrast of Nepal Expedition"
        client:load
        initialLocale={lang}
        initialDict={dict}
        initialFallbackDict={enDict}
    />
</Layout>
