---
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'fr' } }];
}

import { useAstroI18n } from "../../../i18n/astro";
import Layout from "../../../layouts/Layout.astro";
import TripItineraryPage from "../../../components/TripItineraryPage";

import mustangImg from "../../../assets/images/activities/photography/mustang deserts.webp";
import type { Locale } from "../../../i18n/i18n";

const { lang, baseUrl, tripData, dict, enDict } = await useAstroI18n(Astro.url);
const trip = tripData("photography.mustang") || {};

const packingList = [
    {
        category: "Camera Gear & Lenses",
        items: [
            "Full-frame DSLR or Mirrorless Body (Backup body highly recommended)",
            "Wide-angle lens (16-35mm) for trans-Himalayan canyons and Durbar Squares",
            "Mid-range zoom (24-70mm) for Tiji Festival masked dances & street photography",
            "Super Telephoto lens (100-400mm or 200-600mm) for Bengal tigers & river wildlife in Bardiya",
            "Fast Prime lens (35mm or 50mm f/1.4 - f/1.8) for low-light monastery interiors",
            "Sturdy Tripod for star trails & landscape panoramas",
            "Camera sensor cleaning kit & dust blowers (essential for Mustang desert winds)",
            "Rain/dust protective camera covers & dry bags",
            "Extra batteries & solar/power banks (limited power in high Mustang villages)",
        ],
    },
    {
        category: "Clothing & Off-Road Gear",
        items: [
            "Sturdy high-ankle trekking boots for rocky desert terrain",
            "Warm thermal base layers, fleece jacket & down coat (cold Mustang mornings)",
            "Breathable lightweight safari clothing for hot, humid Bardiya jungle days",
            "Sun hat, UV sunglasses & high-factor sunscreen",
            "Dust mask or buff for dirt road vehicle drives",
            "Water filtration bottle or purification tablets",
        ],
    },
];
---
<Layout
    title={`${trip.title || 'Mustang & Bardiya Tiji Festival Expedition'} | Marga Adventure`}
    image={mustangImg.src}
    keywords="Mustang Bardiya Photography, Tiji Festival photography, Royal Bardiya tiger tracking, Upper Mustang trek, Lo Manthang festival, Nepal wildlife safari"
>
    <TripItineraryPage
        title={trip.title || "Mustang & Bardiya Tiji Festival Expedition"}
        subtitle={trip.subtitle || "Ancient Tibetan Rituals, Trans-Himalayan Deserts & Royal Bardiya Wilderness"}
        heroImage={mustangImg.src}
        overview={trip.overview || ""}
        highlights={trip.highlights || []}
        itinerary={trip.itinerary || []}
        tripStats={{
            duration: trip.duration || "14 Days",
            maxAltitude: trip.maxAltitude || "3,840m",
            maxAltitudeLabel: trip.maxAltitudeLabel || "Max Altitude",
            difficulty: trip.difficulty || "Moderate",
            groupSize: trip.groupSize || "2-10",
        }}
        showElevationGraph={false}
        packingList={packingList}
        client:load
        initialLocale={lang}
        initialDict={dict}
        initialFallbackDict={enDict}
    />
</Layout>

