        caption7: "Traverser les ponts suspendus oscillants du Dolpo.",
        caption7_2:
            "Sentiers sinueux taillés dans les falaises de la montagne.",
        caption7_3:
            "Tracer le chemin le long de la gorge de la rivière impétueuse.",
        caption8:
            "Chaque grande amitié commence quelque part. La nôtre a commencé autour d'un thé.",
        caption9: "Marcher côte à côte, partager le voyage.",
        caption10:
            "Des cascades jaillissant à travers les gorges bordées de pins du Dolpo.",
        caption11: "La spectaculaire cascade de Jharana dévalant la montagne.",
        caption12: "Valait bien tous les retards.",
        caption13: "Un miroir de turquoise pure reflétant les cieux.",
        caption14:
            "Heures dorées et reflets sereins du coucher de soleil sur Phoksundo.",
        caption15: "Le meilleur souvenir du Dolpo.",
        caption16:
            "Nous étions venus pour le lac. Nous sommes repartis avec une histoire.",

        prev: "Histoire Précédente",
        back: "Retour au Journal",
    },
};

const { lang, baseUrl, t, dict } = await useAstroI18n(Astro.url);
const d = content[lang];
